# ==============================================================
# 建筑行业 AI 智能助手 - 环境变量配置模板
# 复制此文件为 .env 并填入真实的 API Key
# ==============================================================

# -------------------- LLM (DeepSeek) --------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek 推理模型（产生思维链，需 USE_REASONING=true）
DEEPSEEK_REASONING_MODEL=deepseek-reasoner
# 是否启用推理链模式（true/false）
USE_REASONING=false

# -------------------- 魔搭社区 (ModelScope) --------------------
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api.modelscope.cn

# Embedding 模式: "local" (离线, 默认) 或 "api" (需网络 + MODELSCOPE_API_KEY)
EMBEDDING_MODE=local

# Embedding 模型 (仅 EMBEDDING_MODE=api 时使用)
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# Rerank 模型
RERANK_MODEL=Qwen/Qwen3-Reranker-8B

# -------------------- 应用配置 --------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_ENV=development
