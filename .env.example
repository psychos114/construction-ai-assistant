# ==============================================================
# 建筑行业 AI 智能助手 - 环境变量配置模板
# 复制此文件为 .env 并填入真实的 API Key
# ==============================================================

# -------------------- LLM (DeepSeek) --------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# -------------------- 魔搭社区 (ModelScope) --------------------
MODELSCOPE_API_KEY=
MODELSCOPE_BASE_URL=https://api.modelscope.cn

# Embedding 模型
EMBEDDING_MODEL=

# Rerank 模型
RERANK_MODEL=

# -------------------- 应用配置 --------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000
APP_ENV=development
